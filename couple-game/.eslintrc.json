{
  "root": true,
  "env": { "es2021": true, "node": true },
  "parserOptions": { "ecmaVersion": 2021, "sourceType": "script" },
  "extends": "eslint:recommended",
  "rules": {
    "no-unused-vars": ["error", { "args": "none" }]
  },
  "overrides": [
    {
      "files": ["public/**/*.js"],
      "env": { "browser": true, "node": false, "es2017": true },
      "parserOptions": { "ecmaVersion": 2017 }
    }
  ]
}
